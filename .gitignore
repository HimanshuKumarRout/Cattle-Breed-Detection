# ==========================================
# Cattle Breed Classifier - Git Ignore Rules
# ==========================================

# Virtual Environments & Python
.venv/
venv/
env/
ENV/
build/
devel/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg

# Byte-compiled / Optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Node & Frontend Build Output
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ML Model Checkpoints & Large Data
ml/artifacts/checkpoints/*.pth
ml/artifacts/checkpoints/*.pt
ml/artifacts/checkpoints/*.ckpt
ml/artifacts/checkpoints/*.onnx
ml/artifacts/checkpoints/*.h5
ml/data/raw/*
ml/data/processed/*
!ml/data/.gitkeep
!ml/artifacts/checkpoints/.gitkeep
!ml/artifacts/reports/.gitkeep

# Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# Logs & Temporary Files
*.log
logs/
backend.log
tunnel.log

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
